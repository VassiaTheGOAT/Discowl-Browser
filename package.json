{
  "name": "discowl-browser",
  "version": "1.2.1",
  "description": "Discowl Browser - A new gen browser",
  "main": "main/main.js",
  "author": "Discowl",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.discowl.browser",
    "productName": "Discowl Browser",
    "publish": {
      "provider": "github",
      "owner": "VassiaTheGOAT",
      "repo": "Discowl-Browser"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**",
      "preload/**",
      "renderer/**",
      "components/**",
      "store/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/logo-discowl.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Discowl Browser",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "extraResources": [
      {
        "from": "tor",
        "to": "tor"
      }
    ]
  }
}