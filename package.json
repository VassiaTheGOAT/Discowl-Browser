{
  "name": "discowl-browser",
  "version": "1.3.8",
  "author": "QUESNEL-TALLEC Vassia",
  "license": "GPL-3.0-only",
  "description": "Discowl - New gen browser",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win",
    "build:all": "electron-builder -wml",
    "release": "electron-builder --win --publish always",
    "release:draft": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.discowl.browser",
    "productName": "Discowl Browser",
    "publish": {
      "provider": "github",
      "owner": "VassiaTheGOAT",
      "repo": "Discowl-Browser",
      "releaseType": "release"
    },
    "files": [
      "main/**",
      "preload/**",
      "renderer/**",
      "components/**",
      "store/**",
      "assets/**",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "Discowl-Setup.exe",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/logo-discowl.ico",
      "executableName": "Discowl Browser",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "Discowl Browser",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "differentialPackage": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/logo-discowl.png",
      "category": "Network;WebBrowser"
    },
    "extraResources": [
      {
        "from": "tor",
        "to": "tor"
      }
    ],
    "generateUpdatesFilesForAllChannels": true
  }
}
